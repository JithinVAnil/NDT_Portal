# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://nielit:nielit_demo@localhost:5432/nielit_portal
# Generate your own, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Password assigned to all seeded demo accounts and to learner accounts created at onboarding
DEMO_PASSWORD=Demo@12345
# Load demo data automatically when the database is empty
AUTO_SEED=true
MAX_UPLOAD_MB=1024
